{
  "cleanUrls": true,
  "redirects": [
    { "source": "/services", "destination": "/products", "permanent": true },
    { "source": "/pricing", "destination": "/plans", "permanent": true },
    { "source": "/about", "destination": "/company", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
