# EG Eloma – Apache config (cPanel, Hostinger and other Apache/LiteSpeed hosts).
# Copied into dist/ on every build. Upload the contents of dist/ to the site root (public_html).

Options -MultiViews -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Old static-site links (/index.html, /seo.html ...) -> clean URLs, 301 so Google updates its index.
  # THE_REQUEST only matches what the browser asked for, so the internal rewrite to index.html below never loops.
  RewriteCond %{THE_REQUEST} \s/+index\.html[?\s] [NC]
  RewriteRule ^ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+([a-z0-9-]+)\.html[?\s] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # Real files and folders (JS, CSS, images, fonts, sitemap.xml, robots.txt) are served as they are.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # A missing file under /assets/ stays a real 404 instead of returning the page.
  RewriteRule ^assets/ - [L,R=404]

  # Every other URL (/seo, /contact, /privacy, a refreshed page ...) is handled by the React app.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
  # index.html must always be fresh so visitors get the latest build straight away.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Built JS/CSS files have a content hash in their names, so they can be cached for a year.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(woff2|png|jpe?g|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>
