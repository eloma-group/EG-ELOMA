# EG Eloma – Apache config (cPanel, Hostinger and other Apache/LiteSpeed hosts).
# Copied into dist/ on every build. Upload the contents of dist/ to the site root (public_html).

Options -MultiViews -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Renamed pages -> their new URLs (keep in sync with RENAMED in src/App.tsx).
  RewriteRule ^services(\.html)?$ /products [R=301,L]
  RewriteRule ^pricing(\.html)?$ /plans [R=301,L]
  RewriteRule ^about(\.html)?$ /company [R=301,L]

  # Old static-site links (/index.html, /seo.html ...) -> clean URLs, 301 so Google updates its index.
  # THE_REQUEST only matches what the browser asked for, so the internal rewrite to index.html below never loops.
  RewriteCond %{THE_REQUEST} \s/+index\.html[?\s] [NC]
  RewriteRule ^ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+([a-z0-9-]+)\.html[?\s] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # Real files and folders (JS, CSS, images, fonts, sitemap.xml, robots.txt) are served as they are.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Every page is prebuilt as static HTML: /seo is served from seo.html (works on refresh too).
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([a-z0-9-]+)$ $1.html [L]

  # Any other URL (typos, removed pages) is a real 404, answered with the "Page not found" page below.
  RewriteRule ^ - [R=404,L]
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
  # Pages must always be fresh so visitors get the latest build straight away.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Built JS/CSS files have a content hash in their names, so they can be cached for a year.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(woff2|png|jpe?g|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>
