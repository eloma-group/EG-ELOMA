{
  "trailingSlash": "never",
  "routes": [
    {
      "route": "/index.html",
      "redirect": "/",
      "statusCode": 301
    },
    {
      "route": "/services",
      "redirect": "/products",
      "statusCode": 301
    },
    {
      "route": "/services.html",
      "redirect": "/products",
      "statusCode": 301
    },
    {
      "route": "/pricing",
      "redirect": "/plans",
      "statusCode": 301
    },
    {
      "route": "/pricing.html",
      "redirect": "/plans",
      "statusCode": 301
    },
    {
      "route": "/about",
      "redirect": "/company",
      "statusCode": 301
    },
    {
      "route": "/about.html",
      "redirect": "/company",
      "statusCode": 301
    },
    {
      "route": "/assets/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  },
  "globalHeaders": {
    "Cache-Control": "no-cache",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "mimeTypes": {
    ".woff2": "font/woff2",
    ".webmanifest": "application/manifest+json"
  }
}