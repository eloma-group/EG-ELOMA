<?xml version="1.0" encoding="utf-8"?>
<!--
  EG Eloma – IIS config (Windows hosting, Plesk on Windows, Azure App Service on Windows).
  Copied into dist/ on every build. Needs the IIS URL Rewrite module (installed on almost every Windows host).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Old static-site links -> clean URLs (301, so Google updates its index). -->
        <rule name="index.html to root" stopProcessing="true">
          <match url="^index\.html$" ignoreCase="true" />
          <action type="Redirect" url="/" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Old .html pages to clean URLs" stopProcessing="true">
          <match url="^([a-z0-9-]+)\.html$" ignoreCase="true" />
          <action type="Redirect" url="/{R:1}" redirectType="Permanent" appendQueryString="true" />
        </rule>

        <!-- Every page is prebuilt as static HTML: /seo is served from seo.html (works on refresh too). -->
        <rule name="Prebuilt pages" stopProcessing="true">
          <match url="^([a-z0-9-]+)$" ignoreCase="true" />
          <conditions>
            <add input="{REQUEST_FILENAME}.html" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="/{R:1}.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- Any other URL (typos, removed pages) is a real 404, answered with the "Page not found" page. -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>

    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <staticContent>
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <!-- Pages must always be fresh; /assets gets long caching below. -->
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

  <!-- JS/CSS (hashed names), fonts and images can be cached by the browser. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
